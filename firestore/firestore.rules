rules_version = '2';

// NeighborShare Firestore Security Rules
//
// Design principle (§23 of project spec): authorisation must never rely
// solely on hiding UI elements. These rules are the actual enforcement
// layer and must independently reject any write the client-side code
// would have prevented.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires `firebase login` + `firebase use <project-id>` run locally by
// the project owner - see Deployment_and_Source_Links.txt)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).role == 'admin';
    }

    function isActiveAccount() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc(request.auth.uid).accountStatus == 'active';
    }

    function bookingDoc(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    function isBookingParty(bookingId) {
      let b = bookingDoc(bookingId);
      return isSignedIn() && (b.ownerId == request.auth.uid || b.borrowerId == request.auth.uid);
    }

    // True if the OTHER party in this booking has blocked the current user -
    // used to stop a blocked user from continuing to message someone who
    // has blocked them, even though they're still technically a booking
    // party (§ Trust & Moderation: Blocking).
    function otherPartyBlockedSender(bookingId) {
      let b = bookingDoc(bookingId);
      let other = b.ownerId == request.auth.uid ? b.borrowerId : b.ownerId;
      return exists(/databases/$(database)/documents/blocks/$(other + '_' + request.auth.uid));
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid);
      // Users may edit their own profile but may NEVER self-assign role,
      // verificationStatus, trustScore, accountStatus, or
      // activeRestrictions - those are owner-restricted / system-computed
      // fields. activeRestrictions specifically was added in Rebuild
      // Phase 18's security review after finding it had been left
      // unprotected in Phase 16 - a self-write of activeRestrictions: []
      // would have silently bypassed every restriction, including
      // cannot_message, which is enforced entirely by reading this field.
      allow update: if isSelf(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.trustScore == resource.data.trustScore &&
        request.resource.data.get('activeRestrictions', []) == resource.data.get('activeRestrictions', [])
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---- neighborhoods ----
    // Read requires sign-in (not fully public) because each neighborhood
    // document includes its shared verification code - see §9 MVP
    // simplification note. Any active user can add a missing neighborhood;
    // only admins can edit/delete one, since editing a verification code
    // after residents have already joined using the old one would be a
    // real integrity problem, not just a cosmetic edit.
    match /neighborhoods/{neighborhoodId} {
      allow read: if isSignedIn();
      allow create: if isActiveAccount() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- items ----
    match /items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isActiveAccount() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isActiveAccount() &&
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ---- bookings ----
    // Booking state transitions are additionally validated server-side in
    // the Next.js API route (src/lib/booking/stateMachine.ts) before any
    // Firestore write is issued, using a Firestore transaction to prevent
    // race conditions between concurrent overlapping requests. See
    // Technical_Debt_Plan.pdf NS-TD-03 for the documented limits of this
    // approach under true distributed concurrency.
    match /bookings/{bookingId} {
      allow read: if isActiveAccount() &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.borrowerId == request.auth.uid ||
         isAdmin());
      allow create: if isActiveAccount() &&
        request.resource.data.borrowerId == request.auth.uid &&
        request.resource.data.state == 'REQUESTED';
      allow update: if isActiveAccount() &&
        (resource.data.ownerId == request.auth.uid ||
         resource.data.borrowerId == request.auth.uid ||
         isAdmin());
      allow delete: if isAdmin();

      // ---- bookings/{bookingId}/messages ---- (Chat, scoped to a booking)
      // Deliberately scoped to a booking rather than open free-form DMs
      // between any two neighbors: it keeps chat tied to a legitimate
      // reason to talk (an actual lending transaction), which is both
      // simpler to build and a smaller abuse surface than an open inbox.
      match /messages/{messageId} {
        // Admin is deliberately NOT included here - admin conversation
        // access must go through POST /api/admin/bookings/{id}/messages,
        // which requires a reason and writes an audit log entry for every
        // access. Letting admins read this collection directly via the
        // client SDK would be an unlogged bypass of that requirement.
        allow read: if isBookingParty(bookingId);
        allow create: if isActiveAccount() && isBookingParty(bookingId) &&
          request.resource.data.senderId == request.auth.uid &&
          !otherPartyBlockedSender(bookingId) &&
          !('cannot_message' in userDoc(request.auth.uid).get('activeRestrictions', []));
        allow update, delete: if isAdmin();
      }
    }

    // ---- reviews ----
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isActiveAccount() &&
        request.resource.data.reviewerId == request.auth.uid &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // ---- damageReports ----
    match /damageReports/{reportId} {
      allow read: if isActiveAccount() &&
        (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isActiveAccount() &&
        request.resource.data.reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- notifications ----
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn(); // created by trusted server logic (API routes) with Admin SDK, which bypasses rules; this allows client-side fallback writes only to the user's own doc
      allow delete: if isAdmin();
    }

    // ---- wishlists ----
    match /wishlists/{wishlistId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isActiveAccount() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isActiveAccount() && resource.data.userId == request.auth.uid;
    }

    // ---- neighbourhoodVerificationRequests ----
    // Kept alongside the existing self-service verification code flow
    // (§9 MVP simplification) rather than replacing it - this gives users
    // without a working code a fallback path reviewed by an administrator.
    match /neighbourhoodVerificationRequests/{requestId} {
      // Rebuild Phase 10: a representative may read (review) requests for
      // their own neighbourhood, matching brief §19's "admin/neighbourhood
      // representative review" - not scoped to any other neighbourhood.
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        (userDoc(request.auth.uid).role == 'representative' &&
         userDoc(request.auth.uid).neighborhoodId == resource.data.neighborhoodId)
      );
      allow create: if isActiveAccount() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'PENDING';
      // Review decisions (approve/reject) go through the Admin SDK API
      // route only, so every decision is paired with an audit log entry
      // and a notification - never a bare client-side status flip.
      allow update, delete: if false;
    }

    // ---- accountRestrictions ---- (Rebuild Phase 16)
    // Written exclusively through the Admin SDK API routes (apply/lift),
    // same pattern as auditLogs/blocks - so every restriction is always
    // paired with a reason, an audit log entry, and a notification.
    match /accountRestrictions/{restrictionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---- blocks ---- (Trust & Moderation: Blocking)
    // Written exclusively through API routes using the Admin SDK (which
    // bypasses these rules), so we can validate the target user exists,
    // prevent self-blocking, and write a matching audit log entry in one
    // server-side transaction. Clients only ever read their own blocks.
    match /blocks/{blockId} {
      allow read: if isSignedIn() && (resource.data.blockerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ---- auditLogs ---- (Trust & Moderation: Audit Logging)
    // Admin-only read, no client writes at all - every entry is written
    // server-side via src/lib/auditLog.ts from the specific API routes
    // that perform a moderation action (suspend, remove listing,
    // block/unblock), so the trail can't be tampered with or bypassed.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
